# AutoWX 环境变量示例。
# 复制为 .env 或配置到 GitHub Actions Secrets / Variables。

# 必填 —— AI
MODEL_API_KEY=sk-xxx
MODEL_API_BASE=https://api.example.com/v1
MODEL_NAME=deepseek-v4-flash

# 可选 —— 模型与生成
# ROUTER_MODEL=mimo-v2.5
# BOT_MAX_TOKENS=32768
# ROUTER_MAX_TOKENS=1000

# 必填 —— 联网搜索
TAVILY_API_KEY=tvly-xxx

# 必填 —— 群
VX_GROUPS_JSON=["群1","群2"]

# 可选 —— 机器人
# BOT_NICKNAME=bot
# BOT_CONTEXT_SIZE=10
